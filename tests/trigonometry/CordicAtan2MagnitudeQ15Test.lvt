        AssertResult(-11995, -6615, -27511, 13698)
        AssertResult(-4076, -3044, -26077, 5087)
        AssertResult(3843, 527, 1421, 3879)
        AssertResult(11762, 4098, 3497, 12455)
        AssertResult(19681, 7669, 3876, 21122)
        AssertResult(27600, 11240, 4034, 29801)
        AssertResult(-30017, 14811, 27987, 33472)
        AssertResult(-22098, 18382, 25531, 28744)
        AssertResult(-14179, 21953, 22366, 26134)
        AssertResult(-6260, 25524, 18893, 26280)
