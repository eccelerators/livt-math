namespace Livt.Math.Tests.Approximation

using Livt.Math.Approximation

@Test
component SpecialFunctionsTest
{
	logarithm: Log2UQ15
	exponential: Exp2Q11
	interpolator: LinearInterpolationQ15

	new()
	{
		logarithm = new Log2UQ15()
		exponential = new Exp2Q11()
		interpolator = new LinearInterpolationQ15()
	}

	@Test
	fn InterpolatesSignedEndpoints()
	{
		assert interpolator.Compute(-100, 100, 0) == -100
		assert interpolator.Compute(-100, 100, 16384) == 0
		assert interpolator.Compute(-100, 100, 32768) == 100
		assert interpolator.Compute(100, -100, 8192) == 50
		assert interpolator.Compute(0, 100, -1) == 0
		assert interpolator.Compute(0, 100, 40000) == 100
	}

	@Test
	fn ComputesLogarithmReferencePoints()
	{
		AssertLog(1, -30720)
		AssertLog(8192, -4096)
		AssertLog(16384, -2048)
		AssertLog(32768, 0)
		AssertLog(46341, 1024)
		AssertLog(65535, 2048)
	}

	@Test
	fn RejectsZeroLogarithm()
	{
		assert logarithm.Compute(32768 as uint)
		assert !logarithm.Compute(0 as uint)
		assert logarithm.GetResult() == 0
	}

	@Test
	fn ComputesExponentialReferencePoints()
	{
		AssertExp(-30720, 1)
		AssertExp(-2048, 16384)
		AssertExp(0, 32768)
		AssertExp(1024, 46341)
		AssertExp(2048, 65535)
	}

	@Test
	fn RejectsExponentialInputsOutsideDomain()
	{
		assert exponential.Compute(0)
		assert !exponential.Compute(Exp2Q11.MIN_INPUT - 1)
		assert exponential.GetResult() == (0 as uint)
		assert !exponential.Compute(Exp2Q11.MAX_INPUT + 1)
		assert exponential.GetResult() == (0 as uint)
	}

	fn AssertLog(input: int, expected: int)
	{
		assert logarithm.Compute(input as uint)
		var difference = logarithm.GetResult() - expected
		if (difference < 0) {
			difference = 0 - difference
		}
		assert difference <= Log2UQ15.MAX_ERROR
	}

	fn AssertExp(input: int, expected: int)
	{
		assert exponential.Compute(input)
		var actual = exponential.GetResult() as int
		var difference = actual - expected
		if (difference < 0) {
			difference = 0 - difference
		}
		assert difference <= (Exp2Q11.MAX_ERROR as int)
	}
    /** Reference values sampled independently from the mathematical definitions. */
    @Test
    fn ChecksIndependentReferenceVectors()
    {
        AssertLog(38, -19972)
        AssertExp(-30000, 1)
        AssertLog(2037, -8208)
        AssertExp(-29000, 2)
        AssertLog(4036, -6188)
        AssertExp(-28000, 3)
        AssertLog(6035, -4999)
        AssertExp(-27000, 4)
        AssertLog(8034, -4154)
        AssertExp(-26000, 5)
        AssertLog(10033, -3497)
        AssertExp(-25000, 7)
        AssertLog(12032, -2960)
        AssertExp(-24000, 10)
        AssertLog(14031, -2506)
        AssertExp(-23000, 14)
        AssertLog(16030, -2113)
        AssertExp(-22000, 19)
        AssertLog(18029, -1765)
        AssertExp(-21000, 27)
        AssertLog(20028, -1455)
        AssertExp(-20000, 38)
        AssertLog(22027, -1174)
        AssertExp(-19000, 53)
        AssertLog(24026, -917)
        AssertExp(-18000, 74)
        AssertLog(26025, -681)
        AssertExp(-17000, 104)
        AssertLog(28024, -462)
        AssertExp(-16000, 146)
        AssertLog(30023, -258)
        AssertExp(-15000, 204)
        AssertLog(32022, -68)
        AssertExp(-14000, 287)
        AssertLog(34021, 111)
        AssertExp(-13000, 402)
        AssertLog(36020, 280)
        AssertExp(-12000, 564)
        AssertLog(38019, 439)
        AssertExp(-11000, 792)
        AssertLog(40018, 591)
        AssertExp(-10000, 1111)
        AssertLog(42017, 735)
        AssertExp(-9000, 1558)
        AssertLog(44016, 872)
        AssertExp(-8000, 2186)
        AssertLog(46015, 1003)
        AssertExp(-7000, 3066)
        AssertLog(48014, 1129)
        AssertExp(-6000, 4301)
        AssertLog(50013, 1249)
        AssertExp(-5000, 6033)
        AssertLog(52012, 1365)
        AssertExp(-4000, 8463)
        AssertLog(54011, 1477)
        AssertExp(-3000, 11871)
        AssertLog(56010, 1584)
        AssertExp(-2000, 16652)
        AssertLog(58009, 1688)
        AssertExp(-1000, 23359)
        AssertLog(60008, 1788)
        AssertExp(0, 32768)
        AssertLog(62007, 1884)
        AssertExp(1000, 45966)
    }
}
