namespace Livt.Math.Sqrt

using Livt.Lang.Annotations

/**
 * Computes floor square roots for non-negative signed-int32 values.
 *
 * Newton iterations use division instead of a final x*x comparison so the
 * verification step cannot overflow near the top of the int32 range.
 */
component SqrtInt32
{
	public const ITERATIONS: int = 31

	/** Returns floor(sqrt(value)); non-positive inputs return zero. */
	@SuppressWarning("variable-divisor")
	public fn Compute(value: int) int
	{
		if (value <= 0) { return 0 }
		if (value == 1) { return 1 }

		var root = value / 2 + 1
		for (var iteration = 0; iteration < ITERATIONS; iteration++) {
			var quotient = value / root
			if (root > quotient) { root = (root + quotient) / 2 }
		}

		if (root > value / root) { root-- }
		return root
	}
}
